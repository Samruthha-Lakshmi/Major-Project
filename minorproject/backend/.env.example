# Copy to backend/.env and fill in. Everything here is optional.

# Enables the "Claude AI" narrative engine (otherwise the statistical template engine is used).
ANTHROPIC_API_KEY=

# Model used for AI narrative generation.
ADJ_LLM_MODEL=claude-opus-5-5

# Default significance level for the Benjamini–Hochberg FDR control.
ADJ_ALPHA=0.05

# Upload / dataset limits.
ADJ_MAX_UPLOAD_MB=50
ADJ_MAX_ROWS=500000
