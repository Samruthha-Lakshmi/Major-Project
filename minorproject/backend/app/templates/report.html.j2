<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ story.headline }} — The Data Desk</title>
<meta name="description" content="{{ story.standfirst }}">
<meta name="generator" content="Automated Data Journalism Pipeline">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap">
<style>
:root{
  --paper:#fbf8f3; --ink:#15171b; --muted:#5d636d; --rule:#e3ddd2; --card:#fff;
  --accent:#e8492a; --teal:#138f85; --warn:#b7791f; --chip:#f1ece3;
  --serif:"Fraunces",Georgia,"Times New Roman",serif; --sans:"Inter",system-ui,-apple-system,"Segoe UI",sans-serif;
  --mono:"JetBrains Mono",ui-monospace,Consolas,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){--paper:#0e1013;--ink:#eceae6;--muted:#9aa1ab;--rule:#262a31;--card:#15181d;--chip:#1c2027;--accent:#ff6a4a;--teal:#2cc7b9}
}
:root[data-theme="dark"]{--paper:#0e1013;--ink:#eceae6;--muted:#9aa1ab;--rule:#262a31;--card:#15181d;--chip:#1c2027;--accent:#ff6a4a;--teal:#2cc7b9}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--ink);font:17px/1.65 var(--sans);text-rendering:optimizeLegibility}
a{color:var(--accent)}
.wrap{max-width:760px;margin:0 auto;padding:0 20px}
.wide{max-width:1040px;margin:0 auto;padding:0 20px}
.masthead{border-bottom:3px double var(--ink);padding:18px 0 10px;margin-bottom:28px}
.masthead .wide{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}
.brand{font:800 26px/1 var(--serif);letter-spacing:-.02em}
.brand span{color:var(--accent)}
.edition{font:500 12px/1.4 var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
.kicker{display:inline-flex;gap:8px;align-items:center;font:600 12px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}
.kicker i{width:8px;height:8px;border-radius:50%;background:var(--accent);display:inline-block}
h1{font:800 clamp(32px,5.4vw,54px)/1.05 var(--serif);letter-spacing:-.025em;margin:14px 0 16px}
.standfirst{font:400 21px/1.45 var(--serif);color:var(--muted);margin:0 0 20px}
.byline{display:flex;flex-wrap:wrap;gap:6px 16px;font:500 13px var(--sans);color:var(--muted);border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);padding:10px 0;margin-bottom:28px}
.byline b{color:var(--ink)}
.badge{display:inline-flex;align-items:center;gap:6px;padding:2px 9px;border-radius:99px;background:var(--chip);font:600 11px var(--mono);letter-spacing:.04em}
.badge.ok{color:var(--teal)}
.keynums{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:1px;background:var(--rule);border:1px solid var(--rule);margin:0 0 34px}
.keynums div{background:var(--card);padding:16px}
.keynums strong{display:block;font:800 30px/1.1 var(--serif);color:var(--accent);letter-spacing:-.02em}
.keynums span{display:block;font:500 12.5px/1.4 var(--sans);color:var(--muted);margin-top:6px}
.lede{font-size:19px}
.lede::first-letter{float:left;font:800 64px/.85 var(--serif);padding:6px 10px 0 0;color:var(--accent)}
section.finding{margin:46px 0;padding-top:8px;border-top:1px solid var(--rule)}
.finding .num{font:600 12px var(--mono);color:var(--muted);letter-spacing:.1em}
h2{font:700 28px/1.2 var(--serif);letter-spacing:-.015em;margin:6px 0 12px}
h3{font:700 20px/1.3 var(--serif);margin:34px 0 10px}
figure{margin:22px 0 8px;background:var(--card);border:1px solid var(--rule);border-radius:10px;padding:10px 6px 4px}
.chart{width:100%;height:380px}
figcaption{font:13px/1.5 var(--sans);color:var(--muted);padding:6px 10px 8px}
details.stat{margin-top:10px;font:13px/1.6 var(--mono);color:var(--muted);background:var(--chip);border-radius:8px;padding:8px 12px}
details.stat summary{cursor:pointer;font-weight:600;color:var(--ink)}
details.stat dl{display:grid;grid-template-columns:max-content 1fr;gap:2px 14px;margin:8px 0 2px}
details.stat dt{color:var(--muted)} details.stat dd{margin:0;color:var(--ink)}
.box{background:var(--card);border:1px solid var(--rule);border-radius:12px;padding:20px 22px;margin:26px 0}
.box h3{margin-top:0}
.steps{counter-reset:s;list-style:none;padding:0;margin:0;display:grid;gap:8px}
.steps li{counter-increment:s;display:grid;grid-template-columns:28px 1fr;gap:10px;font-size:15px}
.steps li::before{content:counter(s);width:24px;height:24px;border-radius:50%;background:var(--ink);color:var(--paper);font:600 12px/24px var(--mono);text-align:center}
table{width:100%;border-collapse:collapse;font-size:14px}
th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--rule);vertical-align:top}
th{font:600 11.5px var(--mono);text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
td.n{font-family:var(--mono);text-align:right;white-space:nowrap}
.tablewrap{overflow-x:auto}
ul.caveats{padding-left:20px} ul.caveats li{margin:6px 0}
footer{margin:60px 0 0;padding:24px 0 40px;border-top:3px double var(--ink);font:13px var(--sans);color:var(--muted)}
.warn{color:var(--warn)}
@media (max-width:600px){body{font-size:16px}.standfirst{font-size:18px}.chart{height:300px}h2{font-size:24px}}
@media print{.masthead{border-color:#000}figure{break-inside:avoid}details.stat{display:none}body{background:#fff;color:#000}}
</style>
</head>
<body>
<header class="masthead">
  <div class="wide">
    <div class="brand">The Data <span>Desk</span></div>
    <div class="edition">{{ dateline }} · Automated edition · Report {{ r.run_id[:8] }}</div>
  </div>
</header>

<main>
<article class="wrap">
  <div class="kicker"><i></i>Data analysis · {{ r.source.name }}</div>
  <h1>{{ story.headline }}</h1>
  <p class="standfirst">{{ story.standfirst }}</p>
  <div class="byline">
    <span>By <b>the Automated Data Desk</b></span>
    <span>{{ dateline }}</span>
    <span>{{ "{:,}".format(r.profile.rows) }} records · {{ r.stats.n_tests }} tests</span>
    {% if story.engine == "ai" and story.verification %}
      <span class="badge ok">✓ {{ story.verification.verified }}/{{ story.verification.checked }} AI passages fact-checked</span>
    {% else %}
      <span class="badge">Statistical narrative engine</span>
    {% endif %}
  </div>

  {% if key_numbers %}
  <div class="keynums">
    {% for k in key_numbers %}<div><strong>{{ k.value }}</strong><span>{{ k.label }}</span></div>{% endfor %}
  </div>
  {% endif %}

  <p class="lede">{{ story.lede }}</p>

  {% for f in findings %}
  {% set s = sections.get(f.id) %}
  <section class="finding" id="f{{ loop.index }}">
    <div class="num">FINDING {{ "%02d"|format(loop.index) }} · {{ f.kind|replace("_"," ")|upper }}</div>
    <h2>{{ s.heading if s else f.title }}</h2>
    <p>{{ s.body if s else "" }}</p>
    {% if f.chart %}
    <figure>
      <div class="chart" data-chart="{{ f.id }}"></div>
      <figcaption>{{ f.chart.reason }}</figcaption>
    </figure>
    {% endif %}
    <details class="stat">
      <summary>Statistical note</summary>
      <dl>
        <dt>Method</dt><dd>{{ f.stat.test }}</dd>
        {% if f.stat.statistic is not none %}<dt>Statistic</dt><dd>{{ "%.4g"|format(f.stat.statistic) }}</dd>{% endif %}
        {% if f.stat.p is not none %}<dt>p-value</dt><dd>{{ f.stat.p|pval }}</dd>{% endif %}
        {% if f.stat.q is not none %}<dt>FDR q-value</dt><dd>{{ "%.3g"|format(f.stat.q) }}</dd>{% endif %}
        {% if f.stat.effect is not none %}<dt>Effect size</dt><dd>{{ f.stat.effect_name }} = {{ "%.3f"|format(f.stat.effect) }} ({{ f.stat.magnitude }})</dd>{% endif %}
        {% if f.stat.n %}<dt>Sample</dt><dd>n = {{ "{:,}".format(f.stat.n) }}</dd>{% endif %}
        {% if f.details.alt_test %}<dt>Robustness</dt><dd>{{ f.details.alt_test }}: {{ f.details.alt_p|pval }}</dd>{% endif %}
        <dt>Newsworthiness</dt><dd>{{ "%.2f"|format(f.score) }}</dd>
      </dl>
    </details>
  </section>
  {% endfor %}

  {% if r.anomalies.points or r.anomalies.multivariate %}
  <h3>Records that need a second look</h3>
  <p>These records sit far outside the normal range. They may be the most interesting stories in the data — or data-entry errors. Verify each before publication.</p>
  <div class="tablewrap"><table>
    <thead><tr><th>Record</th><th>Measure</th><th style="text-align:right">Value</th><th style="text-align:right">Typical</th><th style="text-align:right">Robust z</th></tr></thead>
    <tbody>
    {% for p in r.anomalies.points[:8] %}
      <tr><td>{{ p.label }}</td><td>{{ p.column|human }}</td><td class="n">{{ p.value|num }}</td><td class="n">{{ p.median|num }}</td><td class="n">{{ "%.1f"|format(p.robust_z) }}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% if r.anomalies.multivariate %}
  <p style="font-size:14px;color:var(--muted)">An Isolation Forest across all measures also flagged {{ r.anomalies.multivariate|length }} records whose <em>combination</em> of values is unusual, led by {{ r.anomalies.multivariate[0].label }}.</p>
  {% endif %}
  {% endif %}

  {% if overview_json != "[]" %}
  <h3>The bigger picture</h3>
  <figure><div class="chart" data-overview="0" style="height:420px"></div>
  <figcaption>{{ r.overview_charts[0].reason }}</figcaption></figure>
  {% endif %}

  <div class="box">
    <h3>How this story was produced</h3>
    <ol class="steps">
      <li><span><b>Ingestion &amp; validation.</b> {{ "{:,}".format(r.ingest.rows) }} rows × {{ r.ingest.cols }} columns loaded from {{ r.source.name }}; column types inferred automatically.</span></li>
      <li><span><b>Preprocessing.</b> {{ r.preprocess.duplicates_removed }} duplicates removed, {{ r.preprocess.imputed|length }} columns with gaps filled, outliers flagged (not deleted).</span></li>
      <li><span><b>Exploratory analysis.</b> Every column profiled{% if r.profile.time_axis %}; time axis “{{ r.profile.time_axis.column }}” resampled by {{ r.profile.time_axis.unit }}{% endif %}.</span></li>
      <li><span><b>Statistical testing.</b> {{ r.stats.n_tests }} tests (correlation, t-test/ANOVA, χ², trend); {{ r.stats.n_significant }} significant after Benjamini–Hochberg correction at α = {{ r.stats.alpha }}.</span></li>
      <li><span><b>Insight &amp; anomaly detection.</b> Findings ranked by significance × effect size; anomalies found with robust z-scores and an Isolation Forest.</span></li>
      <li><span><b>Visualization.</b> One chart type chosen per finding based on the data's shape.</span></li>
      <li><span><b>Narrative.</b> {% if story.engine == "ai" %}Written by {{ story.model }} from the validated facts only, then every number was machine-checked against the statistics.{% else %}Generated by deterministic templates driven directly by the test results.{% endif %}</span></li>
    </ol>
  </div>

  <h3>Caveats</h3>
  <ul class="caveats">{% for c in story.caveats %}<li>{{ c }}</li>{% endfor %}</ul>

  {% if r.ingest.issues %}
  <h3>Data quality notes</h3>
  <ul class="caveats">{% for i in r.ingest.issues %}<li class="{{ 'warn' if i.level != 'info' else '' }}">{{ i.message }}</li>{% endfor %}</ul>
  {% endif %}

  <h3>Appendix: the measures at a glance</h3>
  <div class="tablewrap"><table>
    <thead><tr><th>Measure</th><th style="text-align:right">Mean</th><th style="text-align:right">Median</th><th style="text-align:right">Std dev</th><th style="text-align:right">Min</th><th style="text-align:right">Max</th></tr></thead>
    <tbody>
    {% for name, c in r.profile.columns.items() if c.semantic == "numeric" and c.mean is defined %}
      <tr><td>{{ name|title_case }}</td><td class="n">{{ c.mean|num }}</td><td class="n">{{ c.median|num }}</td><td class="n">{{ c.std|num }}</td><td class="n">{{ c.min|num }}</td><td class="n">{{ c.max|num }}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>

  <footer>
    Generated by the Automated Data Journalism Pipeline in {{ "%.1f"|format(r.duration_ms / 1000) }} s.
    Every figure in this article is traceable to a statistical test listed in its note.
    Source: {{ r.source.name }}{% if r.source.url %} — <a href="{{ r.source.url }}">{{ r.source.url }}</a>{% endif %}.
  </footer>
</article>
</main>

{% if plotly_inline %}<script>{{ plotly_inline|safe }}</script>{% else %}<script src="{{ plotly_cdn }}" charset="utf-8"></script>{% endif %}
<script>
(function(){
  var charts = {{ chart_json|safe }};
  var overview = {{ overview_json|safe }};
  if (!window.Plotly) return;
  var dark = matchMedia('(prefers-color-scheme: dark)').matches && document.documentElement.dataset.theme !== 'light';
  var ink = getComputedStyle(document.documentElement).getPropertyValue('--ink').trim();
  function draw(el, fig){
    var layout = Object.assign({}, fig.layout, {font: Object.assign({}, fig.layout.font, {color: ink}), autosize: true});
    if (dark) { layout.xaxis = Object.assign({}, layout.xaxis, {gridcolor:'rgba(255,255,255,.08)'}); layout.yaxis = Object.assign({}, layout.yaxis, {gridcolor:'rgba(255,255,255,.08)'}); }
    Plotly.newPlot(el, fig.data, layout, {responsive: true, displaylogo: false, modeBarButtonsToRemove: ['lasso2d','select2d']});
  }
  document.querySelectorAll('[data-chart]').forEach(function(el){ var f = charts[el.dataset.chart]; if (f) draw(el, f); });
  document.querySelectorAll('[data-overview]').forEach(function(el){ var f = overview[+el.dataset.overview]; if (f) draw(el, f); });
})();
</script>
</body>
</html>
